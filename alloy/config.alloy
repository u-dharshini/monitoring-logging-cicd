logging {
  level = "info"
}
local.file_match "lab_logs" {
  path_targets = [{
    "__path__" = "/var/log/lab/*.log",
    "job" = "monitoring-lab",
  }]
}
loki.source.file "lab_logs" {
  targets    = local.file_match.lab_logs.targets
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
